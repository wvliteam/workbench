# 运行时状态：每个项目 wb.py init 时自己生成，不属于工作台本体
.workbench/

# 挂进来的代码库各有自己的远程，整棵源码入口忽略；repos/index.md 是仓库索引、
# repos/<项目>/<仓库>/ 是画像三件套（职责/启动/测试），都是工作区材料，要进版本
repos/.source/*
!repos/.source/.gitkeep

# Claude Code 本地覆盖配置
.claude/settings.local.json

# repos_apply.py 按本机磁盘扫描生成（scanRepositories 各机器仓库不同，提交会反复 churn）
.vscode/

__pycache__/
*.py[cod]
output/
web/frontend/dist/
web/frontend/node_modules/
