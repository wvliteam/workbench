# wbsvr —— 契约托管服务的 sudo 允许清单。
#
# 由 wbsvr/install.sh 生成到 /etc/sudoers.d/wbsvr，__AGENT_USER__ 换成实际 agent 账户。
# 手工装的话记得 visudo -cf 校验后再放进去，语法错的 sudoers 会锁死整台机器的 sudo。
#
# 四个子命令刻意不在清单里：
#   init          它会建一份全新的空存储，等于「一键清空所有冻结」
#   unlock        用户的 sudo 密码就是凭证 —— 它拿不到、不会漏进 transcript、不用管过期
#   dispute-clear agent 能自己清掉争议的话，争议就只是个建议。与 unlock 同理
#   sealed-set    role_scopes 是「自己给自己发权限」，gate_commands 是「让门禁永远 PASS」
#
# sudoers 的通配符不是安全边界：参数按**拼接后的整串**做匹配，`*` 跨空格也跨 `/`，
# 且不规范化 `..` —— `wbsvrd read *` 会放行 `wbsvrd read ../../etc/shadow`。参数校验
# 必须在 wbsvrd 里（refName / storeDir），这份清单只管「哪些子命令能跑」。

Cmnd_Alias WBSVR_READ = /usr/local/libexec/wbsvrd ping, \
                        /usr/local/libexec/wbsvrd version, \
                        /usr/local/libexec/wbsvrd list *, \
                        /usr/local/libexec/wbsvrd read *, \
                        /usr/local/libexec/wbsvrd verify *, \
                        /usr/local/libexec/wbsvrd sealed-get *, \
                        /usr/local/libexec/wbsvrd selfcheck *

# 写路径。每一条在 wbsvrd 里都有服务端约束：commit 撞锁定就拒；lock 换期望指纹要有
# 解冻窗口；phase-advance 只能前进一格；tasks-graph-set 在 design 之后只能追加。
Cmnd_Alias WBSVR_WRITE = /usr/local/libexec/wbsvrd commit *, \
                         /usr/local/libexec/wbsvrd lock *, \
                         /usr/local/libexec/wbsvrd dispute *, \
                         /usr/local/libexec/wbsvrd phase-advance *, \
                         /usr/local/libexec/wbsvrd tasks-graph-set *

__AGENT_USER__ ALL=(wbsvr) NOPASSWD: WBSVR_READ, WBSVR_WRITE

# 认证缓存缓存的是「认证」不是「授权」：正常情况下 agent 跑 unlock 会因为不匹配任何
# 规则被拒，跟缓存无关。但 agent 账户一旦也命中 %admin ALL=(ALL) ALL，用户刚输过密码
# 的那 15 分钟里它就能直接 sudo -u wbsvr /bin/sh。这一行与「agent 不进 admin 组」
# 两条都要 —— 开发机上后一条通常不成立，别当它不在。
Defaults:__AGENT_USER__ timestamp_timeout=0
